# .latexmkrc — abnTeX2 thesis with BibTeX and glossaries (lista de siglas / glossário).
# Copy to the project root as ".latexmkrc" (Linux/macOS/Overleaf: "latexmkrc" also works).
# latexmk already runs pdflatex/bibtex in the right order; these lines teach it makeglossaries.
$pdf_mode = 1;                 # pdflatex → PDF
$bibtex_use = 2;               # run bibtex whenever the .bib or citations change
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');
add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
$clean_ext .= ' acr acn alg glo gls glg ist run.xml';
sub run_makeglossaries {
  my ($base, $path) = fileparse($_[0]);
  my $cwd = Cwd::getcwd();
  chdir $path if $path;
  my $ret = system('makeglossaries', $base);
  chdir $cwd;
  return $ret;
}
